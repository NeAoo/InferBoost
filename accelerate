#!/usr/bin/env bash
set -euo pipefail
INFERENCE_PROJECT_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
export PYTHONDONTWRITEBYTECODE=1
export PYTHONPATH="$INFERENCE_PROJECT_ROOT${PYTHONPATH:+:$PYTHONPATH}"
exec "${PIPELINE_PYTHON:-python3}" -m pipeline.inference.cli --root "$INFERENCE_PROJECT_ROOT" "$@"
